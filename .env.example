# Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is only used by server-side scripts (never exposed to the browser).
# Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The wedding date, used across the whole app for countdown + urgency calculations
NEXT_PUBLIC_WEDDING_DATE=2026-12-11
NEXT_PUBLIC_PLANNING_START_DATE=2026-01-11
NEXT_PUBLIC_COUPLE_NAMES="Anushka & Rohan"
